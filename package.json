{
  "name": "docx2pdf-cli",
  "version": "1.0.0",
  "description": "CLI for docx2pdf converter",
  "main": "cli.js",
  "bin": "cli.js",
  "scripts": {
    "test": "npm run test",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/docx2pdf.exe",
    "build:sh": "pkg . --targets node18-linux-x64 --output dist/docx2pdf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bansnetsajak007/docx2pdf-converter.git"
  },
  "keywords": [
    "docx2pdf"
  ],
  "author": "Sajak",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Bansnetsajak007/docx2pdf-converter/issues"
  },
  "homepage": "https://github.com/Bansnetsajak007/docx2pdf-converter#readme",
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "pkg": {
    "assets": ["index.js", "node_modules/adm-zip/**/*"]
  }
}

